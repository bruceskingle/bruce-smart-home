{
	// Things which only run a command, in a terminal, rather than debug: Terminal > Run Task, or Tasks: Run Task from
	// the Command Palette, picks one and runs it. The debugging ones are in launch.json.
	"version": "2.0.0",
	"tasks": [
		{
			// Builds the capture device's firmware for a Waveshare ESP32-S3-RLCD-4.2, see capture/README.md, and flashes it
			// to the first board on its chip's own USB, /dev/cu.usbmodem*, then shows its log. The flasher refuses firmware
			// for another board than the one on the port.
			"label": "Device: Flash RLCD",
			"type": "shell",
			"command": "./build-firmware.sh wave-esp32s3-rlcd-42 && bruce-embedded-flash flash --port \"$(ls /dev/cu.usbmodem* | head -1)\" --monitor \"$(./build-firmware.sh --path wave-esp32s3-rlcd-42)\"",
			"options": { "cwd": "${workspaceFolder}/capture" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
		},
		{
			// As Device: Flash RLCD, for a Guition JC3248W535C, the Guitron.
			"label": "Device: Flash Guitron",
			"type": "shell",
			"command": "./build-firmware.sh guition-jc3248w535c && bruce-embedded-flash flash --port \"$(ls /dev/cu.usbmodem* | head -1)\" --monitor \"$(./build-firmware.sh --path guition-jc3248w535c)\"",
			"options": { "cwd": "${workspaceFolder}/capture" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "focus": true, "panel": "dedicated" }
		},
		{
			// Builds the virtual capture device, the capture firmware for the board simulator, once for each board it
			// simulates, and its launcher, as debug builds, into capture/target-sim/bin, see capture/README.md. The
			// Virtual Device launch configurations run it first.
			"label": "Virtual Device: Build",
			"type": "shell",
			"command": "./build-sim.sh --debug",
			"options": { "cwd": "${workspaceFolder}/capture" },
			"problemMatcher": ["$rustc"],
			"presentation": { "reveal": "silent", "panel": "dedicated" }
		},
		{
			// Serves the documentation book, see book.toml, at http://localhost:3000 and opens it in the browser. It is
			// rebuilt and the browser reloaded whenever a file in docs or book changes. Stop it to stop the server. Needs
			// mdBook, install it with: cargo binstall mdbook
			"label": "Docs: Serve Book",
			"type": "shell",
			"command": "mdbook serve --open",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"isBackground": true,
			"presentation": { "reveal": "always", "panel": "dedicated" }
		}
	]
}
